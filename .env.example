# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Service-role key — SERVER ONLY, never prefix with NEXT_PUBLIC_.
# Used by the API routes that read/write encrypted profile PII and by the
# public /track endpoint (which calls the scoped track_trip RPC).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Key for application-level PII encryption (AES-256-GCM). SERVER ONLY.
# Generate with:  openssl rand -base64 32
# Names, phone numbers and next-of-kin contacts are encrypted with this before
# they reach Postgres, so a database dump or Supabase dashboard login shows
# ciphertext only.
#
# ⚠️  LOSE THIS KEY AND THE DATA IS UNRECOVERABLE. Back it up somewhere safe.
# ⚠️  Rotating it requires re-encrypting every row (decrypt with old, encrypt
#     with new) — there is no migration path built in.
PII_ENCRYPTION_KEY=your-base64-32-byte-key

# EmailJS credentials — used to send SOS email alerts to next-of-kin.
# NOTE: the NEXT_PUBLIC_ prefix is required; lib/email.ts runs in the browser.
# https://dashboard.emailjs.com/
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your-emailjs-service-id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your-emailjs-template-id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your-emailjs-public-key
# Optional: reply-to address shown in SOS emails (e.g. support@yourdomain.ng).
# Do NOT use nysc.gov.ng addresses — this project is not NYSC-affiliated.
# NEXT_PUBLIC_EMAILJS_REPLY_TO=support@yourdomain.ng
